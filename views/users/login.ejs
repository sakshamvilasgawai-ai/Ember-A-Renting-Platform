<% layout('layouts/boilerplate') %>

<div class="auth-page">
  <div class="auth-card">
    <div class="logo">🔥Ember</div>
    <h2>Welcome back</h2>

    <form action="/login" method="POST">
      <div class="form-group">
        <label>Username</label>
        <input type="text" name="username" placeholder="Enter your username" required/>
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" placeholder="Enter your password" required/>
      </div>
      <button type="submit" class="btn-book">Login →</button>
    </form>

    <p style="text-align:center;margin-top:1.2rem;font-size:0.88rem;color:#78716C;">
      Don't have an account? <a href="/signup" style="color:#F97316;font-weight:600;">Sign up</a>
    </p>
  </div>
</div>